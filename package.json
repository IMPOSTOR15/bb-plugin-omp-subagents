{
  "name": "bb-plugin-omp-subagents",
  "version": "0.1.1",
  "type": "module",
  "description": "Watch, inspect, and steer the subagents an OMP thread spawns: live roster, transcripts, progress, and message injection in BB's own UI.",
  "license": "MIT",
  "author": "IMPOSTOR15",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IMPOSTOR15/bb-plugin-omp-subagents.git"
  },
  "homepage": "https://github.com/IMPOSTOR15/bb-plugin-omp-subagents#readme",
  "bugs": {
    "url": "https://github.com/IMPOSTOR15/bb-plugin-omp-subagents/issues"
  },
  "keywords": [
    "bb-plugin",
    "omp",
    "subagents",
    "observability",
    "agents"
  ],
  "engines": {
    "bb": ">=0.47",
    "bbPluginSdk": ">=0.6.73"
  },
  "bb": {
    "name": "OMP Subagents",
